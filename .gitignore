# Binaries
/bin/
/dist/
*.exe
*.exe~
*.dll
*.so
*.dylib
/yoyo
/yoyo-desktop

# Frontend
frontend/node_modules/
# Built assets stay local. Keep one tracked stub so `go:embed all:frontend/dist`
# compiles before `npm run build` (CI `go test ./...` and a clean clone).
frontend/dist/*
!frontend/dist/.keep
frontend/bindings/
frontend/playwright-report/
frontend/test-results/
frontend/playwright/.cache/
.task/

# Wails / build
build/bin/
*.syso

# Go modules (repo root only; frontend/src/vendor is committed source)
/vendor/
coverage.out
*.test

# IDE / OS
.idea/
.vscode/
.DS_Store
Thumbs.db
*.swp

# Local agent data
.yoyo/
*.log
.env
.env.*

# Test scratch
/tmp/
testdata/tmp/
evals/.materialized/

# Research PDF cache (fetch with scripts/fetch-research-originals.ps1)
docs/research/originals/*.pdf
